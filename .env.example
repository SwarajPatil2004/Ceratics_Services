# ==============================================================================
# Ceratics Environment Variables
# Duplicate this file to .env.local for local development.
# Configure these variables in your Vercel Project Settings under "Environment Variables".
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site URL & Canonical Domain
# ------------------------------------------------------------------------------
# Used in metadata, sitemap.xml, robots.txt, and OpenGraph link generation.
# Default fallback is "https://ceratics.com".
NEXT_PUBLIC_APP_URL=https://ceratics.com

# ------------------------------------------------------------------------------
# 2. Google Analytics 4 (GA4)
# ------------------------------------------------------------------------------
# Your GA4 Measurement ID (format: G-XXXXXXXXXX).
# If omitted or empty, Google Analytics scripts will not be injected.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 3. Cal.com Scheduling Integration
# ------------------------------------------------------------------------------
# The handle/event link for your Cal.com booking embed on the /contact page.
# Format: "username/event-slug" (e.g. "ceratics/15min").
# Defaults to "ceratics/15min" if not specified.
NEXT_PUBLIC_CALCOM_LINK=ceratics/15min

# ------------------------------------------------------------------------------
# 4. Contact Form Webhook Forwarding (Optional)
# ------------------------------------------------------------------------------
# Any HTTP POST endpoint to receive contact form submissions (JSON payload).
# Compatible with Zapier, Make.com, GoHighLevel, Slack Incoming Webhooks, or Discord.
CONTACT_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 5. Email Notifications via Resend (Optional)
# ------------------------------------------------------------------------------
# If you want automated email alerts when a lead submits the /contact form:
# 1. Sign up at https://resend.com and grab an API key.
# 2. Add your key and recipient notification address below.
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=hello@ceratics.com
