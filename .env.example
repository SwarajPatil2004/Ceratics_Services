# =======================================================
# Ceratics Environment Configuration Example
# =======================================================

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cal.com Booking Link (defaults to "ceratics/15min")
NEXT_PUBLIC_CALCOM_LINK=ceratics/15min

# Optional: Webhook URL for forwarding contact form submissions (e.g. Zapier, Make, GoHighLevel, Slack)
CONTACT_WEBHOOK_URL=

# Optional: Resend API Key & Email for direct inbox alerts on contact submissions
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=hello@ceratics.com
